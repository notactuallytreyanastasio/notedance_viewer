<Layouts.app flash={@flash}>
  <div
    id="page"
    data-page="kid"
    data-score-id={@score.noteflight_id}
    data-timeline-url={"/s/#{@score.noteflight_id}/timeline"}
    class="kid select-none"
  >
    <header class="kid-top">
      <div class="kid-row">
        <h1 class="kid-title">{@score.title}</h1>
        <button
          type="button"
          id="btn-tour"
          class="btn-help"
          aria-label="Walk me through using this"
          title="Walk me through using this"
        >?</button>
      </div>

      <section id="instruments" class="instruments">
        <p id="pick-prompt" class="pick-prompt">Tap your instrument</p>
        <p class="pick-hint">You will see just your part, nice and big.</p>
        <div id="parts" class="bars"></div>
      </section>

      <div id="kid-status" class="kid-status" data-status="none">
        <span class="live-dot" aria-hidden="true"></span>
        <span id="kid-part" class="part-pill hidden"></span>
        <span id="kid-status-text" aria-live="polite">Pick an instrument to start</span>
        <button type="button" id="btn-change" class="btn-change hidden">Change instrument</button>
      </div>
    </header>

    <main class="sheet">
      <div id="osmd" class="osmd"></div>
      <div id="sheet-loading" class="sheet-loading hidden">
        <span class="loader" aria-hidden="true"><i></i><i></i><i></i><i></i></span>Drawing your part…
      </div>
    </main>
  </div>
</Layouts.app>
