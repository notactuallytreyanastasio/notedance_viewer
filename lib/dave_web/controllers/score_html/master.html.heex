<div id="page"
     data-page="master"
     data-score-id={@score.noteflight_id}
     data-timeline-url={"/s/#{@score.noteflight_id}/timeline"}
     data-musicxml-url={"/s/#{@score.noteflight_id}/musicxml"}
     class="select-none">

  <header class="sticky top-0 z-20 bg-white/90 backdrop-blur px-4 py-3 border-b border-zinc-200">
    <div class="flex flex-wrap items-center gap-3">
      <span class="text-xl font-bold"><%= @score.title %></span>
      <span id="status-dot" class="inline-block w-3 h-3 rounded-full bg-zinc-300"></span>
      <span id="position" class="text-sm text-zinc-500 tabular-nums">0.0s</span>

      <div class="ml-auto flex items-center gap-2">
        <button id="btn-restart" class="rounded-lg border border-zinc-300 px-4 py-2 font-semibold">⏮</button>
        <button id="btn-play" class="rounded-lg bg-orange-600 px-6 py-2 font-semibold text-white text-lg">▶</button>
        <button id="btn-pause" class="rounded-lg border border-zinc-300 px-4 py-2 font-semibold">⏸</button>
        <button id="btn-mute" class="rounded-lg border border-zinc-300 px-4 py-2 font-semibold">🔊</button>
      </div>
    </div>
    <div class="flex flex-wrap gap-2 mt-3">
      <span class="text-sm text-zinc-500 mr-1 self-center">Go to measure:</span>
      <div id="measures" class="flex flex-wrap gap-2"></div>
    </div>
  </header>

  <main class="px-2 pt-4">
    <div id="osmd" class="osmd-large"></div>
  </main>
</div>
