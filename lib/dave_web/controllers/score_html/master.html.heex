<Layouts.app flash={@flash}>
  <div
    id="page"
    data-page="master"
    data-score-id={@score.noteflight_id}
    data-timeline-url={"/s/#{@score.noteflight_id}/timeline"}
    data-musicxml-url={"/s/#{@score.noteflight_id}/musicxml"}
    data-kid-path={"/s/#{@score.noteflight_id}"}
    class="master select-none"
  >
    <header class="tv-top">
      <div class="tv-row">
        <a href="/" class="back" aria-label="Back to songs">
          <.icon name="hero-chevron-left" class="size-6" />
        </a>
        <div class="tv-title">
          <h1>{@score.title}</h1>
          <div id="tv-time" class="tv-time">
            <span id="position">0:00</span> / <span id="duration">0:00</span>
          </div>
        </div>

        <div id="transport" class="transport">
          <button
            type="button"
            id="btn-restart"
            class="tb"
            aria-label="Start over"
            title="Start over"
          >
            <.icon name="hero-backward" class="size-7" />
          </button>
          <button type="button" id="btn-play" class="tb tb-play" data-playing="false">
            <.icon name="hero-play-solid" class="size-9 icon-play" />
            <.icon name="hero-pause-solid" class="size-9 icon-pause" />
            <span id="play-label">Play</span>
          </button>
          <button type="button" id="btn-pause" class="tb" aria-label="Pause" title="Pause">
            <.icon name="hero-pause" class="size-7" />
          </button>
          <button
            type="button"
            id="btn-sound"
            class="tb"
            aria-label="Sound on"
            title="Sound on"
            aria-pressed="true"
          >
            <.icon name="hero-speaker-wave" class="size-7 icon-on" />
            <.icon name="hero-speaker-x-mark" class="size-7 icon-off" />
          </button>
        </div>

        <div class="tv-right">
          <button type="button" id="btn-join" class="join-btn">
            <.icon name="hero-qr-code" class="size-6" />
            <span>Kids join</span>
          </button>
          <div id="following" class="following" title="iPads on this song">
            <span id="live-dot" class="live-dot"></span>
            <span id="following-text">No iPads yet</span>
          </div>
          <button type="button" id="btn-tour" class="btn-tour">Walk me through using this</button>
        </div>
      </div>

      <div class="tv-row tv-measures">
        <span class="measures-label">Start from measure</span>
        <div id="measures" class="measures"></div>
      </div>
      <div class="progress" aria-hidden="true">
        <div id="progress-bar" class="progress-bar"></div>
      </div>
    </header>

    <main class="sheet">
      <div id="osmd" class="osmd"></div>
      <div id="sheet-loading" class="sheet-loading">Drawing the score…</div>
    </main>

    <dialog id="join-dialog" class="join-dialog">
      <div class="join-inner">
        <h2>Point the iPad camera here</h2>
        <canvas id="join-qr" width="360" height="360"></canvas>
        <p id="join-url" class="join-url"></p>
        <div class="join-actions">
          <button type="button" id="btn-copy-link" class="btn-secondary">Copy the link</button>
          <button type="button" id="btn-join-close" class="btn-primary">Done</button>
        </div>
      </div>
    </dialog>
  </div>
</Layouts.app>
