<h1 class="text-4xl font-bold mb-2">dave</h1>
<p class="mb-6 text-zinc-500">classroom music viewer — paste a Noteflight score URL, give the kids the link</p>

<form action="/import" method="post" class="flex gap-2 mb-8">
  <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
  <input
    type="url"
    name="url"
    required
    placeholder="https://….learning.noteflight.com/scores/view/…"
    class="flex-1 rounded-lg border border-zinc-300 px-4 py-3 text-lg"
  />
  <button class="rounded-lg bg-orange-600 px-6 py-3 text-lg font-semibold text-white">Import</button>
</form>

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <%= for score <- @scores do %>
    <a href={"/s/#{score.noteflight_id}"} class="block rounded-xl border border-zinc-200 p-4 hover:border-orange-400">
      <div class="text-lg font-semibold"><%= score.title %></div>
      <div class="text-sm text-zinc-500"><%= score.composer %></div>
      <div class="mt-2 text-sm text-zinc-400">
        <%= length(score.parts) %> parts · ♩=<%= round(score.bpm) %> ·
        <%= for part <- score.parts, do: part.short_name <> " " %>
      </div>
    </a>
  <% end %>
</div>

<%= if @scores == [] do %>
  <p class="text-zinc-400">No scores yet. Paste the first one above.</p>
<% end %>
